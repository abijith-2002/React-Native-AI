{
  "name": "reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --host lan",
    "start:web": "PORT=${PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --web",
    "android": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --host lan --android",
    "ios": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --host lan --ios",
    "web": "PORT=${PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --web",
    "lint": "eslint .",
    "prebuild:android": "expo prebuild --platform android",
    "build": "echo \"Expo preview does not use native Gradle build. Use 'npm run ci:preview' or 'npm run start' instead.\"",
    "ci:preview": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --host lan --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "expo": "~53.0.20",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "private": true
}
