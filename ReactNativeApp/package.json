{
  "name": "reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "node scripts/sanitize-args.js",
    "start": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --lan --port ${METRO_PORT:-3030}",
    "start:web": "PORT=${PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --web",
    "android": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --lan --android --port ${METRO_PORT:-3030}",
    "ios": "METRO_PORT=${METRO_PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --lan --ios --port ${METRO_PORT:-3030}",
    "web": "PORT=${PORT:-3030} EXPO_DEV_HOST=0.0.0.0 expo start --web",
    "lint": "eslint .",
    "prebuild:android": "expo prebuild --platform android",
    "build": "echo \"Expo preview does not use native Gradle build. Use 'npm run ci:preview' or 'npm run start' instead.\"",
    "ci:preview": "METRO_PORT=3030 EXPO_DEV_HOST=0.0.0.0 expo start --lan --port 3030 --clear",
    "ci:healthcheck": "node -e \"const http=require('http');const path=process.env.EXPO_PUBLIC_HEALTHCHECK_PATH||'/healthz';http.get({host:'127.0.0.1',port:process.env.METRO_PORT||3030,path},res=>{if(res.statusCode===200){process.exit(0)}else{console.error('Healthcheck failed with',res.statusCode);process.exit(1)}}).on('error',e=>{console.error('Healthcheck error',e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "expo": "~53.0.20",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "private": true
}
